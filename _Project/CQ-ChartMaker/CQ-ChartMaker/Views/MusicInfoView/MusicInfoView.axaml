<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CQ_ChartMaker.Views.MusicInfoView">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#222222"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBackgroundBrush}">
        <TextBlock Text="乐曲信息面板 (MusicInfo)" 
                   Foreground="{StaticResource TextBrush}"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>