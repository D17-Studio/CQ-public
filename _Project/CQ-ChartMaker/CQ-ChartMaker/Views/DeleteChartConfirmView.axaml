<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CQ_ChartMaker.Views.DeleteChartConfirmView"
        Title="删除谱面"
        Width="400" Height="160"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/CQ-icon.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="CancelButtonBrush" Color="#FF333333"/>
    </Window.Resources>

    <Border Background="{StaticResource PanelBackgroundBrush}" Padding="20">
        <Grid RowDefinitions="*,Auto">
            <TextBlock x:Name="MessageText"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="12">
                <Button Content="删除" Click="OnDeleteClick"
                        Background="#FFB03A3A" Foreground="White"
                        Padding="16,6" Cursor="Hand"/>
                <Button Content="取消" Click="OnCancelClick"
                        Background="{StaticResource CancelButtonBrush}" Foreground="White"
                        Padding="16,6" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
