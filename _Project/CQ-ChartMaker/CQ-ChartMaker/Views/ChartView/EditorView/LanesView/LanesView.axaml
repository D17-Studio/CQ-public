<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CQ_ChartMaker.ViewModels"
             x:Class="CQ_ChartMaker.Views.LanesView"
             x:DataType="vm:LanesViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#222222"/>
        <SolidColorBrush x:Key="LaneBoxBrush" Color="#1a1a1a"/>
        <SolidColorBrush x:Key="LaneBorderBrush" Color="#FFAAAAAA"/>
        <SolidColorBrush x:Key="JudgmentLineBrush" Color="#FFC800"/>
        <SolidColorBrush x:Key="BeatLineBrush" Color="#FF888888"/>
        <SolidColorBrush x:Key="SubBeatLineBrush" Color="#FF633737"/>
        <!-- LaneMotion 节点颜色（与 BPM 节点相同的浅灰） -->
        <SolidColorBrush x:Key="MotionBrush" Color="#FFCCCCCC"/>
        <SolidColorBrush x:Key="NodeStrokeBrush" Color="White"/>
        <SolidColorBrush x:Key="SplitterBrush" Color="#FF000000"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 放置工具栏按钮基础样式 -->
        <Style Selector="ToggleButton.PlacingBtn">
            <Setter Property="Width" Value="33"/>
            <Setter Property="Height" Value="33"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.PlacingBtn:pointerover">
            <Setter Property="Background" Value="#FF3A3A3A"/>
        </Style>
        <!-- 选中时：背景为 Motion 节点颜色（浅灰），文字为工具栏深灰 -->
        <Style Selector="ToggleButton.PlacingBtn.MotionBtn:checked">
            <Setter Property="Background" Value="{StaticResource MotionBrush}"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:LanesViewModel/>
    </Design.DataContext>

    <Grid Background="{StaticResource PanelBackgroundBrush}" x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition Width="33"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧主编辑区 -->
        <Grid Grid.Column="0">
            <!-- 轨道竖条（底层） -->
            <ItemsControl x:Name="LaneContainer" ItemsSource="{Binding VisibleLanes}" Margin="40,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="{Binding LaneSpacing}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Border Width="{Binding DataContext.LaneWidth, ElementName=RootGrid}"
                                    Background="{StaticResource LaneBoxBrush}"
                                    BorderBrush="{StaticResource LaneBorderBrush}"
                                    BorderThickness="1"/>
                            <TextBlock Text="{Binding}"
                                       Foreground="{StaticResource LaneBorderBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       FontSize="10" Margin="0,0,0,2"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 节拍编号（左侧 40px，代码后置渲染） -->
            <Canvas x:Name="BeatLabelCanvas" Width="40" HorizontalAlignment="Left"/>

            <!-- 细分线（节拍线下层，代码后置渲染） -->
            <Canvas x:Name="SubBeatLineCanvas" Margin="40,0,0,0"/>

            <!-- 节拍线段（与轨道区域对齐，代码后置渲染） -->
            <Canvas x:Name="BeatLineCanvas" Margin="40,0,0,0"/>

            <!-- 判定线覆盖层 -->
            <Canvas Name="JudgmentCanvas" Margin="40,0,0,0">
                <Border Name="JudgmentLine" Background="{StaticResource JudgmentLineBrush}" Height="2"
                        IsHitTestVisible="False"/>
                <Polygon Name="JudgmentTriangle" Fill="{StaticResource JudgmentLineBrush}"
                         Points="0,0 0,14 10,7"
                         Cursor="SizeNorthSouth"/>
            </Canvas>

            <!-- LaneMotion 显示层（代码后置渲染，遮住判定线） -->
            <Canvas x:Name="MotionCanvas" Margin="40,0,0,0" Background="Transparent"/>

            <!-- 放置预览层（最上层，代码后置渲染；不参与命中测试，点击穿透到 MotionCanvas） -->
            <Canvas x:Name="PreviewCanvas" Margin="40,0,0,0" IsHitTestVisible="False"/>

            <!-- 框选矩形层（预览之上，代码后置渲染；不参与命中测试） -->
            <Canvas x:Name="BoxSelectCanvas" Margin="40,0,0,0" IsHitTestVisible="False">
                <Border x:Name="BoxSelectBorder" IsVisible="False"
                        Background="#338489F2" BorderBrush="White" BorderThickness="1"/>
            </Canvas>
        </Grid>

        <!-- 分割线 -->
        <Border Grid.Column="1" Background="{StaticResource SplitterBrush}"/>

        <!-- 放置工具栏 -->
        <Border Grid.Column="2" Background="#222222" Padding="0,6">
            <StackPanel Spacing="5" VerticalAlignment="Top" HorizontalAlignment="Center">
                <ToggleButton Name="MotionButton" Content="+" Classes="PlacingBtn MotionBtn"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
