<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CQ_ChartMaker.ViewModels"
             xmlns:views="using:CQ_ChartMaker.Views"
             xmlns:models="using:CQ_ChartMaker.Models"
             xmlns:common="using:CQ_ChartMaker.Common"
             x:Class="CQ_ChartMaker.Views.EditorView"
             x:DataType="vm:EditorViewModel"
             xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <UserControl.Resources>
        <!-- 面板背景色 -->
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#222222"/>
        <!-- 文本颜色 -->
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF"/>
        <!-- 分割线颜色 -->
        <SolidColorBrush x:Key="SplitterBrush" Color="#FF000000"/>

        <!-- Enum 到 Bool 转换器 -->
        <common:EnumToBoolConverter x:Key="EnumToBoolConverter"/>

        <!-- 选项卡按钮样式相关资源（与 MainWindow 保持一致） -->
        <system:Double x:Key="TabButtonWidth">100</system:Double>
        <system:Double x:Key="TabButtonHeight">30</system:Double>
        <system:Double x:Key="TabButtonFontSize">14</system:Double>
        <SolidColorBrush x:Key="TabButtonForeground" Color="White"/>
        <SolidColorBrush x:Key="TabButtonBackground" Color="#222222"/>
        <SolidColorBrush x:Key="TabButtonCheckedBackground" Color="#FF555555"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 选项卡按钮基础样式（无悬停效果，隐藏圆点） -->
        <Style Selector="RadioButton.TabRadio">
            <Setter Property="Background" Value="{StaticResource TabButtonBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TabButtonForeground}"/>
            <Setter Property="FontSize" Value="{StaticResource TabButtonFontSize}"/>
            <Setter Property="Width" Value="{StaticResource TabButtonWidth}"/>
            <Setter Property="Height" Value="{StaticResource TabButtonHeight}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            Height="{TemplateBinding Height}"
                            Width="{TemplateBinding Width}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 选中时高亮背景色 -->
        <Style Selector="RadioButton.TabRadio:checked">
            <Setter Property="Background" Value="{StaticResource TabButtonCheckedBackground}"/>
        </Style>

        <!-- 悬停时背景略微变浅（与“文件/设置”等菜单按钮的悬停效果一致） -->
        <Style Selector="RadioButton.TabRadio:pointerover">
            <Setter Property="Background" Value="#FF3A3A3A"/>
        </Style>
        <!-- 已选中项悬停：在选中高亮 #FF555555 基础上再浅一档 -->
        <Style Selector="RadioButton.TabRadio:checked:pointerover">
            <Setter Property="Background" Value="#FF666666"/>
        </Style>

        <!-- 轨道开关按钮（ToggleButton 显示为数字，带边框） -->
        <Style Selector="ToggleButton.LaneToggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          MinWidth="{TemplateBinding MinWidth}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 隐藏状态：颜色不变，只降低不透明度 -->
        <Style Selector="ToggleButton.LaneToggle:unchecked">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- 细分按钮（方形点击区，文字居中，选中时系统色） -->
        <Style Selector="RadioButton.SubdivisionBtn">
            <Setter Property="Width" Value="33"/>
            <Setter Property="Height" Value="33"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.SubdivisionBtn:pointerover">
            <Setter Property="Background" Value="#FF3A3A3A"/>
        </Style>
        <Style Selector="RadioButton.SubdivisionBtn:checked">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
        </Style>

        <!-- 缩放按钮（纯文字，无边框，悬停显示范围） -->
        <Style Selector="Button.ZoomBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" Width="22" Height="22">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ZoomBtn:pointerover">
            <Setter Property="Background" Value="#FF3A3A3A"/>
        </Style>

        <!-- 永久轨道（0~3）：方框与文字使用系统色 -->
        <Style Selector="ToggleButton.LaneToggle.permanent">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <!-- 非默认且无数据的空轨道：浅红，提示关闭项目后会丢失 -->
        <Style Selector="ToggleButton.LaneToggle.empty">
            <Setter Property="Foreground" Value="#FFE08A8A"/>
            <Setter Property="BorderBrush" Value="#FFE08A8A"/>
        </Style>

        <!-- 底栏新增轨道按钮：与轨道按钮同尺寸，无边框 -->
        <Style Selector="Button.LaneAddBtn">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.LaneAddBtn:pointerover">
            <Setter Property="Background" Value="#FF3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- 事件类型切换按钮：白色边框 + 透明背景；高度与轨道按钮一致（24） -->
        <Style Selector="ToggleButton.EventKindBtn">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 未选中：浅灰（降低不透明度，与轨道按钮一致）；选中：保持白色 -->
        <Style Selector="ToggleButton.EventKindBtn:unchecked">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- 显示模式下拉框：去掉外框和背景，只保留文字与箭头（深色主题下文字/箭头为白色） -->
        <Style Selector="ComboBox.DisplayModeCombo">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Fluent 主题会在悬停 / 按下 / 展开时重新铺背景，这里逐状态改成半透明白，作为点击反馈 -->
        <Style Selector="ComboBox.DisplayModeCombo:pointerover">
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>
        <Style Selector="ComboBox.DisplayModeCombo:pressed">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="ComboBox.DisplayModeCombo:dropdownopen">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:EditorViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 选项卡栏（替代原标题栏，位于顶部） -->
        <Border Grid.Row="0" Background="#222222">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Left">
                <RadioButton GroupName="EditorTabs"
                             Content="Notes"
                             IsChecked="{Binding IsNotesSelected}"
                             Classes="TabRadio"/>
                <RadioButton GroupName="EditorTabs"
                             Content="Events"
                             IsChecked="{Binding IsEventsSelected}"
                             Classes="TabRadio"/>
                <RadioButton GroupName="EditorTabs"
                             Content="Beats"
                             IsChecked="{Binding IsBeatsSelected}"
                             Classes="TabRadio"/>
            </StackPanel>
        </Border>

        <!-- 分割线 1 -->
        <Border Grid.Row="1" Background="{StaticResource SplitterBrush}"/>

        <!-- 动态内容区域 + 右侧细分工具栏 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="33"/>
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Content="{Binding CurrentSubView}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:NotesViewModel">
                        <views:NotesView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:EventsViewModel">
                        <views:EventsView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:BeatsViewModel">
                        <views:BeatsView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <!-- 分割线 -->
            <Border Grid.Column="1" Background="{StaticResource SplitterBrush}"/>

            <!-- 细分工具栏 -->
            <Border Grid.Column="2" Background="#222222" Padding="0,6">
                <StackPanel Spacing="5" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <RadioButton Content="Fr"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.Free}}"
                                 Classes="SubdivisionBtn"/>
                    <RadioButton Content="1"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x1}}"
                                 Classes="SubdivisionBtn"/>
                    <RadioButton Content="1/2"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x2}}"
                                 Classes="SubdivisionBtn"/>
                    <RadioButton Content="1/3"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x3}}"
                                 Classes="SubdivisionBtn"/>
                    <RadioButton Content="1/4"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x4}}"
                                 Classes="SubdivisionBtn"/>
                    <RadioButton Content="1/6"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x6}}"
                                 Classes="SubdivisionBtn"/>
                    <RadioButton Content="1/8"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x8}}"
                                 Classes="SubdivisionBtn"/>
                    <!-- 1/12、1/16 文字较长，末尾数字用略小字号避免挤压 -->
                    <RadioButton IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x12}}"
                                 Classes="SubdivisionBtn">
                        <TextBlock><Run Text="1/"/><Run Text="12" FontSize="12"/></TextBlock>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x16}}"
                                 Classes="SubdivisionBtn">
                        <TextBlock><Run Text="1/"/><Run Text="16" FontSize="12"/></TextBlock>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 分割线 2 -->
        <Border Grid.Row="3" Background="{StaticResource SplitterBrush}"/>

        <!-- 事件类型栏 + 轨道编辑/显隐栏：两行共用 *,Auto 列宽。
             右列由下方缩放控件撑出宽度，因此类型栏右侧会自然空出与缩放区等宽的区域 -->
        <Border Grid.Row="4" Background="#222222">
            <Grid RowDefinitions="Auto,1,Auto" ColumnDefinitions="*,Auto">

                <!-- 事件类型栏（第 0 行）：属于 EditorView，三个子页都占位；
                     仅 Events 页显示按钮，其余页保持空白 -->
                <Panel Grid.Row="0" Grid.Column="0" Margin="8,3,0,3" MinHeight="26">
                    <!-- 类型栏：三种模式共用一组 ToggleButton。
                         轨道=单选当前类型；平铺=多选类型显隐；类型=全部禁用（只作列提示）。
                         WrapPanel：一行放不下时自动换行（与轨道按钮相同） -->
                    <ItemsControl ItemsSource="{Binding TypeBarItems}"
                                  IsVisible="{Binding IsEventsSelected}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TypeBarItem">
                                <ToggleButton Classes="EventKindBtn"
                                              Content="{Binding Text}"
                                              IsEnabled="{Binding IsEnabled}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>

                <!-- 显示模式切换：轨道 / 类型 / 平铺（占满右侧预留区） -->
                <ComboBox Grid.Row="0" Grid.Column="1" Width="90" Height="24"
                          FontSize="12" Margin="10,0,10,0" VerticalAlignment="Center"
                          Classes="DisplayModeCombo"
                          IsVisible="{Binding IsEventsSelected}"
                          SelectedIndex="{Binding DisplayModeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="轨道"/>
                    <ComboBoxItem Content="类型"/>
                    <ComboBoxItem Content="平铺"/>
                </ComboBox>

                <!-- 类型栏与轨道栏之间的黑色细线（跨两列，延伸到右侧预留区） -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1"
                        Background="{StaticResource SplitterBrush}"/>

                <!-- 轨道编辑/显隐栏（第 2 行）：左侧轨道项自动换行，右侧缩放 -->
                <ItemsControl Grid.Row="2" Grid.Column="0" ItemsSource="{Binding LaneBarItems}"
                              VerticalAlignment="Center" Margin="8,5,0,5">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LaneBarItem">
                            <Panel Margin="0,2,2,2">
                                <!-- 轨道显隐按钮：右键直接删除空轨道 -->
                                <ToggleButton Classes="LaneToggle"
                                              Classes.permanent="{Binding IsDefault}"
                                              Classes.empty="{Binding IsEmpty}"
                                              IsVisible="{Binding IsLane}"
                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                              Content="{Binding Text}"
                                              PointerPressed="OnLaneButtonRightClick"/>
                                <!-- 新增轨道 + 按钮（跳号处 / 最右侧） -->
                                <Button Classes="LaneAddBtn"
                                        IsVisible="{Binding IsAdd}"
                                        Content="{Binding Text}"
                                        Command="{Binding AddCommand}"/>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 缩放控制（居右） -->
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="2" Margin="10,5,10,5">
                    <Button Content="-" Command="{Binding ZoomOutCommand}"
                            Classes="ZoomBtn" Width="22" Height="22"/>
                    <TextBlock Text="{Binding ZoomText}" Foreground="{StaticResource TextBrush}"
                               FontSize="14" VerticalAlignment="Center"
                               Width="43" TextAlignment="Center"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}"
                            Classes="ZoomBtn" Width="22" Height="22"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
