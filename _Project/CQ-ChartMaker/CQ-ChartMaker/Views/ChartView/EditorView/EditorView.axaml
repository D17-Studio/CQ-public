<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CQ_ChartMaker.ViewModels"
             xmlns:views="using:CQ_ChartMaker.Views"
             xmlns:models="using:CQ_ChartMaker.Models"
             xmlns:common="using:CQ_ChartMaker.Common"
             x:Class="CQ_ChartMaker.Views.EditorView"
             x:DataType="vm:EditorViewModel"
             xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <UserControl.Resources>
        <!-- 面板背景色 -->
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#222222"/>
        <!-- 文本颜色 -->
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF"/>
        <!-- 分割线颜色 -->
        <SolidColorBrush x:Key="SplitterBrush" Color="#FF000000"/>

        <!-- Enum 到 Bool 转换器 -->
        <common:EnumToBoolConverter x:Key="EnumToBoolConverter"/>

        <!-- 选项卡按钮样式相关资源（与 MainWindow 保持一致） -->
        <system:Double x:Key="TabButtonWidth">100</system:Double>
        <system:Double x:Key="TabButtonHeight">30</system:Double>
        <system:Double x:Key="TabButtonFontSize">14</system:Double>
        <SolidColorBrush x:Key="TabButtonForeground" Color="White"/>
        <SolidColorBrush x:Key="TabButtonBackground" Color="#222222"/>
        <SolidColorBrush x:Key="TabButtonCheckedBackground" Color="#FF555555"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 选项卡按钮基础样式（无悬停效果，隐藏圆点） -->
        <Style Selector="RadioButton.TabRadio">
            <Setter Property="Background" Value="{StaticResource TabButtonBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TabButtonForeground}"/>
            <Setter Property="FontSize" Value="{StaticResource TabButtonFontSize}"/>
            <Setter Property="Width" Value="{StaticResource TabButtonWidth}"/>
            <Setter Property="Height" Value="{StaticResource TabButtonHeight}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            Height="{TemplateBinding Height}"
                            Width="{TemplateBinding Width}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 选中时高亮背景色 -->
        <Style Selector="RadioButton.TabRadio:checked">
            <Setter Property="Background" Value="{StaticResource TabButtonCheckedBackground}"/>
        </Style>

        <!-- 轨道开关按钮（ToggleButton 显示为数字，带边框） -->
        <Style Selector="ToggleButton.LaneToggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          MinWidth="{TemplateBinding MinWidth}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.LaneToggle:checked">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- 细分按钮（方形点击区，文字居中，选中时系统色） -->
        <Style Selector="RadioButton.SubdivisionBtn">
            <Setter Property="Width" Value="33"/>
            <Setter Property="Height" Value="33"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.SubdivisionBtn:pointerover">
            <Setter Property="Background" Value="#FF3A3A3A"/>
        </Style>
        <Style Selector="RadioButton.SubdivisionBtn:checked">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
        </Style>

        <!-- 缩放按钮（纯文字，无边框，悬停显示范围） -->
        <Style Selector="Button.ZoomBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" Width="18" Height="18">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ZoomBtn:pointerover">
            <Setter Property="Background" Value="#FF3A3A3A"/>
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:EditorViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 选项卡栏（替代原标题栏，位于顶部） -->
        <Border Grid.Row="0" Background="#222222">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Left">
                <RadioButton GroupName="EditorTabs"
                             Content="Notes"
                             IsChecked="{Binding IsNotesSelected}"
                             Classes="TabRadio"/>
                <RadioButton GroupName="EditorTabs"
                             Content="Lanes"
                             IsChecked="{Binding IsLanesSelected}"
                             Classes="TabRadio"/>
                <RadioButton GroupName="EditorTabs"
                             Content="Beats"
                             IsChecked="{Binding IsBeatsSelected}"
                             Classes="TabRadio"/>
            </StackPanel>
        </Border>

        <!-- 分割线 1 -->
        <Border Grid.Row="1" Background="{StaticResource SplitterBrush}"/>

        <!-- 动态内容区域 + 右侧细分工具栏 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="33"/>
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Content="{Binding CurrentSubView}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:NotesViewModel">
                        <views:NotesView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:LanesViewModel">
                        <views:LanesView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:BeatsViewModel">
                        <views:BeatsView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <!-- 分割线 -->
            <Border Grid.Column="1" Background="{StaticResource SplitterBrush}"/>

            <!-- 细分工具栏 -->
            <Border Grid.Column="2" Background="#222222" Padding="0,6">
                <StackPanel Spacing="5" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <RadioButton Content="Fr"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.Free}}"
                                 Classes="SubdivisionBtn"/>
                    <RadioButton Content="1"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x1}}"
                                 Classes="SubdivisionBtn"/>
                    <RadioButton Content="1/2"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x2}}"
                                 Classes="SubdivisionBtn"/>
                    <RadioButton Content="1/3"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x3}}"
                                 Classes="SubdivisionBtn"/>
                    <RadioButton Content="1/4"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x4}}"
                                 Classes="SubdivisionBtn"/>
                    <RadioButton Content="1/6"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x6}}"
                                 Classes="SubdivisionBtn"/>
                    <RadioButton Content="1/8"
                                 IsChecked="{Binding Subdivision, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:Subdivision.x8}}"
                                 Classes="SubdivisionBtn"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 分割线 2 -->
        <Border Grid.Row="3" Background="{StaticResource SplitterBrush}"/>

        <!-- 轨道显隐控制栏 -->
        <Border Grid.Row="4" Background="#222222" Padding="4,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 轨道开关 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="2">
                    <ToggleButton IsChecked="{Binding LaneNeg3Visible}" Content="-3" Classes="LaneToggle"/>
                    <ToggleButton IsChecked="{Binding LaneNeg2Visible}" Content="-2" Classes="LaneToggle"/>
                    <ToggleButton IsChecked="{Binding LaneNeg1Visible}" Content="-1" Classes="LaneToggle"/>
                    <ToggleButton IsChecked="{Binding Lane0Visible}" Content="0" Classes="LaneToggle"/>
                    <ToggleButton IsChecked="{Binding LanePos1Visible}" Content="1" Classes="LaneToggle"/>
                    <ToggleButton IsChecked="{Binding LanePos2Visible}" Content="2" Classes="LaneToggle"/>
                    <ToggleButton IsChecked="{Binding LanePos3Visible}" Content="3" Classes="LaneToggle"/>
                </StackPanel>

                <!-- 缩放控制 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="2">
                    <Button Content="-" Command="{Binding ZoomOutCommand}"
                            Classes="ZoomBtn" Width="18" Height="18"/>
                    <TextBlock Text="{Binding ZoomText}" Foreground="{StaticResource TextBrush}"
                               FontSize="12" VerticalAlignment="Center"
                               Width="36" TextAlignment="Center"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}"
                            Classes="ZoomBtn" Width="18" Height="18"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
