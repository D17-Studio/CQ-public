<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CQ_ChartMaker.ViewModels"
             xmlns:common="using:CQ_ChartMaker.Common"
             x:Class="CQ_ChartMaker.Views.ViewView"
             x:DataType="vm:ViewViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#222222"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF"/>
        <GridLength x:Key="HeaderHeight">30</GridLength>
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#222222"/>
        <SolidColorBrush x:Key="SplitterBrush" Color="#FF000000"/>

        <StreamGeometry x:Key="PlayIcon">M 8,5 L 19,12 L 8,19 Z</StreamGeometry>
        <StreamGeometry x:Key="PauseIcon">M 6,5 H 10 V 19 H 6 Z M 14,5 H 18 V 19 H 14 Z</StreamGeometry>
        <!-- local:BoolToPlayPauseIconConverter 改为 common 前缀 -->
        <common:BoolToPlayPauseIconConverter x:Key="BoolToIconConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.IconButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:ViewViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource HeaderHeight}"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}">
            <TextBlock Text="View" Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource SplitterBrush}"/>

        <DockPanel Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" LastChildFill="True">
            <Border DockPanel.Dock="Bottom" Background="Transparent" Padding="20,0,20,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：固定左右时间宽度，按钮居中 -->
                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding FormattedTime}" 
                                   Foreground="White" FontSize="14"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>

                        <Button Grid.Column="1"
                                Command="{Binding TogglePlayPauseCommand}"
                                Classes="IconButton"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <PathIcon Data="{Binding IsPaused, Converter={StaticResource BoolToIconConverter}}"
                                      Foreground="White" Width="16" Height="16"/>
                        </Button>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding MaxTimeFormatted}" 
                                   Foreground="White" FontSize="14"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Slider Grid.Row="1"
                            Minimum="0"
                            Maximum="{Binding MaxTime}"
                            Value="{Binding CurrentTimeMs, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Background="Transparent">
                <TextBlock Text="视图内容区域" Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>